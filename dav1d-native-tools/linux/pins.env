# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by dav1d-native-tools/linux.
# Edit here only. build.sh and container-build.sh both source this file and echo the resolved
# values at the top of every run, so a build log always says exactly what it used.
# ==============================================================================================

# --- Container images -------------------------------------------------------------------------
# The manylinux images exist to fix the glibc baseline. Building on a modern desktop distro
# bakes THAT distro's glibc version into the .so, and glibc symbol versioning is forward-only,
# so the library would then refuse to load on anything older - a failure that only shows up on
# a user's machine.
#
#   image                                  glibc  runs on
#   manylinux_2_28_x86_64                  2.28   Debian 10+, Ubuntu 20.04+, RHEL 8+
#   manylinux_2_28_aarch64                 2.28   every 64-bit Raspberry Pi OS, Ubuntu 20.04+
#   manylinux_2_39_riscv64                 2.39   Ubuntu 24.04+, Debian 13+ (in practice every
#                                                 riscv64 distro is newer than this)
#
# These are the same three images, at the same dated tag and the same digests, that
# CodeBrix.Audio's native tooling uses. The digest is what the build actually pins: the dated
# tag is there so a human can see which image generation it is, but the FROM line in every
# Containerfile resolves to the digest, so an upstream retag cannot silently change the
# toolchain under a rebuild.
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images this tooling builds ON TOP of those (base + meson + ninja + nasm). Building
# one is the documented "install the tools on the build machine" step and is the ONLY step that
# uses the network; the actual library build then runs with --network none.
DERIVED_IMAGE_PREFIX=codebrix-dav1d-build

# --- Build tools installed into the derived images ---------------------------------------------
# Latest versions available on PyPI on 2026-08-28, pinned exactly. dav1d needs meson >= 0.54 and
# any ninja; these are far above the floor. They are installed with pip from the manylinux
# image's own CPython (PYTHON_IN_IMAGE), which is what those images are built around.
MESON_VERSION=1.12.0
NINJA_VERSION=1.13.0
PYTHON_IN_IMAGE=/opt/python/cp313-cp313/bin/python

# nasm is needed only for x86_64 (dav1d's x86 asm is NASM syntax). Floor per dav1d's meson.build.
# It comes from the image's own package manager, so no version is pinned - the Containerfile
# checks the floor instead and fails the image build if it is not met.
NASM_MIN_VERSION=2.14

# The RISC-V vector assembly needs an assembler that accepts `.option arch, +v`:
# GNU binutils >= 2.38 or clang >= 17. The Containerfile PROVES it by assembling a two-line
# test file rather than parsing a version string.
BINUTILS_MIN_FOR_RVV=2.38

# --- Vendored source (in-repo; nothing is fetched at build time) --------------------------------
DAV1D_DIR=dav1d
DAV1D_VERSION=1.5.4
DAV1D_COMMIT=52b9d3d3ec525f5a20849145fa0e879d585f4911
DAV1D_DESCRIBE=1.5.4-1-g52b9d3d3
DAV1D_API_VERSION=7.0.0
DAV1D_SONAME=libdav1d.so.7

# --- dav1d build options -----------------------------------------------------------------------
# --buildtype=release            -O3, NDEBUG
# -Ddefault_library=shared       one .so, no static half
# -Dbitdepths=8,16               both the 8-bit and the 16-bit (10/12-bit) decoder halves
# -Denable_asm=true              hand-written SIMD - the entire point of dav1d
# -Denable_tools=true            builds the dav1d CLI, which the conformance gate needs
#                                (the CLI is NOT shipped in the package)
# -Denable_tests=false           also stops meson from consulting subprojects/checkasm.wrap,
#                                which would want to clone checkasm over the network
# -Denable_examples=false        nothing to ship there
# -Dxxhash_muxer=disabled        the xxh3 muxer needs an xxhash.h that upstream expects you to
#                                drop into tools/output/ yourself. Left on 'auto' the result
#                                would depend on whatever happens to be installed in the build
#                                environment; disabled, every build is the same. md5 - the muxer
#                                the conformance gate uses - is always built in.
DAV1D_MESON_OPTIONS="--buildtype=release -Ddefault_library=shared -Dbitdepths=8,16 -Denable_asm=true -Denable_tools=true -Denable_tests=false -Denable_examples=false -Dxxhash_muxer=disabled"

# --- Verification gate ---------------------------------------------------------------------------
# The highest GLIBC_x.y symbol version the shipped .so may reference. This IS the oldest system
# the binary can load on, so it is checked, not merely reported.
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39

# Shared libraries the .so is allowed to depend on. Anything else is a gate failure: it would
# mean the package demands a library be installed on the user's machine.
ALLOWED_DEPS="libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"

# The conformance vectors and their expected decode hashes (relative to dav1d-native-tools/).
TEST_VECTOR_DIR=test-vectors
TEST_VECTOR_EXPECTED=test-vectors/EXPECTED.md5
